NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/event_planner
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8081
ESTIMATE_TAX_RATE=0
ESTIMATE_ADVANCE_RATE=0.2
