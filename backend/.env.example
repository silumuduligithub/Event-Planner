NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/event_planner
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8081
# OAuth client identifiers are public; create them in Google Cloud and Apple Developer.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=
# Required for customer password recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_RESET_URL=eventlycustomer://reset-password
ESTIMATE_TAX_RATE=0
ESTIMATE_ADVANCE_RATE=0.2
# Required only when running npm run seed; use a unique local value.
SEED_PASSWORD=
