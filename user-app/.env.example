# Local simulators, with the backend running on this computer.
EXPO_PUBLIC_API_URL_IOS=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:4000
# For a physical device, replace its platform-specific URL with a reachable address.
# EXPO_PUBLIC_API_URL is used only when the platform-specific URL is unset.
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000
# Google OAuth native client IDs. Add these IDs to backend GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
